@model List<SharedCircle.ViewModels.AdminPostVM>
@{
    ViewData["Title"] = "Manage Posts";
    Layout = "_AdminLayout";
}

<h4 class="fw-semibold mb-1" style="color:#2b2d33;">Posts</h4>
<p class="text-muted mb-4">@Model.Count post(s) found</p>

<div class="mb-3" style="max-width:350px;">
    <form asp-action="Posts" method="get">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" name="term" class="form-control border-start-0 ps-0"
                   placeholder="Search posts..." value="@ViewBag.SearchTerm">
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">Author</th>
                    <th>Content</th>
                    <th>Created</th>
                    <th>Likes</th>
                    <th>Comments</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No posts found.</td>
                    </tr>
                }
                @foreach (var post in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@post.AuthorId"
                               class="d-flex align-items-center text-decoration-none text-dark">
                                <img src="@(string.IsNullOrEmpty(post.AuthorImage) ? "/images/default-profile.png" : post.AuthorImage)"
                                     width="32" height="32" class="rounded-circle me-2" style="object-fit:cover;">
                                @post.AuthorName
                            </a>
                        </td>
                        <td style="max-width:280px;">
                            <div class="text-truncate">@post.Caption</div>
                        </td>
                        <td class="text-muted">@post.CreatedAt.ToString("MMM dd")</td>
                        <td>@post.LikeCount</td>
                        <td>@post.CommentCount</td>
                        <td class="text-end pe-4">
                            <a asp-action="PostDetails" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>