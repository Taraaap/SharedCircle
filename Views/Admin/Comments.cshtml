@model List<SharedCircle.ViewModels.AdminCommentVM>

@{
    ViewData["Title"] = "Manage Comments";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-1">

    <div>
        <h4 class="fw-semibold mb-1" style="color:#2b2d33;">
            Comments
        </h4>

        <p class="text-muted mb-0">
            @Model.Count total comments
        </p>
    </div>

</div>



<div class="card border-0 shadow-sm rounded-4 mt-4 mb-4">

    <div class="card-body p-3">

        <form asp-action="Comments" method="get">

            <div class="input-group">

                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>

                <input type="text"
                       name="term"
                       value="@ViewBag.SearchTerm"
                       class="form-control border-start-0"
                       placeholder="Search comments, authors or posts..." />

                <button type="submit"
                        class="btn btn-dark px-4">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm))
                {
                    <a asp-action="Comments"
                       class="btn btn-outline-secondary ms-2">
                        Clear
                    </a>
                }

            </div>

        </form>

    </div>

</div>



<div class="card border-0 shadow-sm rounded-4">

    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead>

                <tr class="text-muted small text-uppercase">

                    <th class="ps-4">
                        Author
                    </th>

                    <th>
                        Comment
                    </th>

                    <th>
                        On Post
                    </th>

                    <th>
                        Date
                    </th>

                    <th class="text-end pe-4">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="5"
                            class="text-center py-5">

                            <div class="text-muted">

                                <i class="bi bi-chat-square-text fs-1 d-block mb-3"></i>

                                <h6 class="fw-semibold">
                                    No comments found
                                </h6>

                                <p class="small mb-0">
                                    Try a different search.
                                </p>

                            </div>

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var comment in Model)
                    {
                        <tr>

                            <td class="ps-4">

                                <a asp-controller="Profile"
                                   asp-action="ViewProfile"
                                   asp-route-id="@comment.AuthorId"
                                   class="text-decoration-none text-dark">

                                    <div class="d-flex align-items-center">

                                        <img src="@(string.IsNullOrEmpty(comment.AuthorImage)
                                                                                    ? "/images/default-profile.png"
                                                                                    : comment.AuthorImage)"
                                             width="38"
                                             height="38"
                                             class="rounded-circle me-2"
                                             style="object-fit:cover;">

                                        <span class="fw-semibold">
                                            @comment.AuthorName
                                        </span>

                                    </div>

                                </a>

                            </td>


                         
                            <td style="max-width:280px;">

                                <div class="text-truncate"
                                     title="@comment.Text">

                                    @comment.Text

                                </div>

                            </td>


                          
                            <td style="max-width:220px;">

                                <a asp-action="PostDetails"
                                   asp-route-id="@comment.PostId"
                                   class="text-decoration-none text-dark">

                                    <div class="text-truncate fw-semibold"
                                         title="@comment.PostCaption">

                                        @comment.PostCaption

                                    </div>

                                    <small class="text-muted">

                                        View post
                                        <i class="bi bi-arrow-right ms-1"></i>

                                    </small>

                                </a>

                            </td>


                            <td class="text-muted">

                                @comment.CreatedAt.ToString("MMM dd, yyyy")

                            </td>


                            <td class="text-end pe-4">

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteCommentModal"
                                        data-comment-id="@comment.Id">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>



<div class="modal fade"
     id="deleteCommentModal"
     tabindex="-1"
     aria-labelledby="deleteCommentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header border-0">

                <h5 class="modal-title fw-semibold"
                    id="deleteCommentModalLabel">

                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>

                    Delete Comment

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-2">
                    Are you sure you want to delete this comment?
                </p>

                <p class="text-muted small mb-0">
                    This action cannot be undone.
                </p>

            </div>


            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form asp-action="DeleteComment"
                      method="post"
                      id="deleteCommentForm">

                    <input type="hidden"
                           name="id"
                           id="deleteCommentId" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>

                        Yes, Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const deleteCommentModal =
            document.getElementById('deleteCommentModal');

        deleteCommentModal.addEventListener('show.bs.modal', function(event) {

            const button = event.relatedTarget;

            const commentId =
                button.getAttribute('data-comment-id');

            document.getElementById('deleteCommentId').value = commentId;

        });

    </script>
}