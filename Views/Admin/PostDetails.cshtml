@model SharedCircle.ViewModels.AdminPostVM
@{
    ViewData["Title"] = "Post Details";
    Layout = "_AdminLayout";
}

<a asp-action="Posts" class="text-decoration-none text-muted small mb-3 d-inline-block">
    <i class="bi bi-arrow-left me-1"></i> Back to Posts
</a>

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center mb-3">

                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@Model.AuthorId">
                        <img src="@(string.IsNullOrEmpty(Model.AuthorImage) ? "/images/default-profile.png" : Model.AuthorImage)"
                             width="48" height="48" class="rounded-circle me-3" style="object-fit:cover;">
                    </a>

                    <div>
                        <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@Model.AuthorId"
                           class="text-decoration-none text-dark fw-semibold">
                            @Model.AuthorName
                        </a>
                        <div class="text-muted small">@Model.AuthorEmail</div>
                    </div>

                </div>

                <div class="text-muted small mb-3">
                    Created: @Model.CreatedAt.ToString("MMM dd, yyyy")
                </div>

                <p class="mb-3">@Model.Caption</p>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-3 w-100 mb-3">
                }

                <div class="d-flex gap-4 text-muted mb-4">
                    <span><i class="bi bi-heart-fill text-danger me-1"></i> @Model.LikeCount Likes</span>
                    <span><i class="bi bi-chat-fill me-1"></i> @Model.CommentCount Comments</span>
                </div>

                <button type="button"
                        class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#deletePostModal">
                    <i class="bi bi-trash me-1"></i> Delete Post
                </button>

            </div>

        </div>

    </div>

</div>


<div class="modal fade" id="deletePostModal" tabindex="-1" aria-labelledby="deletePostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header border-0">
                <h5 class="modal-title fw-semibold" id="deletePostModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Delete Post
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body text-muted">
                Are you sure you want to delete this post permanently?
                <br>
                <small>This action cannot be undone.</small>
            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="DeletePost" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Yes, Delete
                    </button>
                </form>

            </div>

        </div>
    </div>
</div>