@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SharedCircle Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            .admin-sidebar {
                background: #0e0f13;
                width: 260px;
                flex-shrink: 0;
            }

                .admin-sidebar .brand {
                    border-bottom: 1px solid #23252b;
                }

                .admin-sidebar .section-label {
                    color: #6b6e78;
                    letter-spacing: 1px;
                    font-size: 0.72rem;
                }

                .admin-sidebar .nav-link-admin {
                    color: #9a9da6;
                    font-size: 0.95rem;
                    transition: color 0.15s ease;
                }

                    .admin-sidebar .nav-link-admin:hover {
                        color: #ffffff;
                    }

                    .admin-sidebar .nav-link-admin.active {
                        color: #5b8def;
                    }

                .admin-sidebar .bottom-bar {
                    border-top: 1px solid #23252b;
                }

            .admin-stat-card {
                border-left: 4px solid #5b8def;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="d-flex" style="min-height:100vh;">

       
        <div class="d-flex flex-column text-white admin-sidebar">

            <div class="brand px-4 py-4 fw-semibold fs-5">
                SharedCircle <span style="color:#5b8def;">Admin</span>
            </div>

            <div class="px-3 pt-4 flex-grow-1">

                <div class="section-label text-uppercase px-2 mb-2">
                    Overview
                </div>

                <a asp-controller="Admin" asp-action="Dashboard"
                   class="d-flex align-items-center text-decoration-none px-2 py-2 mb-4 nav-link-admin @(currentAction == "Dashboard" ? "active" : "")">
                    <i class="bi bi-graph-up fs-5 me-3"></i>
                    <span>Dashboard</span>
                </a>

                <div class="section-label text-uppercase px-2 mb-2">
                    Content
                </div>

                <a asp-controller="Admin" asp-action="Posts"
                   class="d-flex align-items-center text-decoration-none px-2 py-2 mb-2 nav-link-admin @(currentAction == "Posts" ? "active" : "")">
                    <i class="bi bi-file-text fs-5 me-3"></i>
                    <span>Posts</span>
                </a>

                <a asp-controller="Admin" asp-action="Comments"
                   class="d-flex align-items-center text-decoration-none px-2 py-2 mb-4 nav-link-admin @(currentAction == "Comments" ? "active" : "")">
                    <i class="bi bi-chat-left-text fs-5 me-3"></i>
                    <span>Comments</span>
                </a>

                <div class="section-label text-uppercase px-2 mb-2">
                    Management
                </div>

                <a asp-controller="Admin" asp-action="Users"
                   class="d-flex align-items-center text-decoration-none px-2 py-2 mb-2 nav-link-admin @(currentAction == "Users" || currentAction == "CreateUser" ? "active" : "")">
                    <i class="bi bi-people fs-5 me-3"></i>
                    <span>Users</span>
                </a>

                <a asp-controller="Admin" asp-action="Follows"
                   class="d-flex align-items-center text-decoration-none px-2 py-2 mb-2 nav-link-admin @(currentAction == "Follows" ? "active" : "")">
                    <i class="bi bi-person-heart fs-5 me-3"></i>
                    <span>Follows</span>
                </a>

            </div>

            <div class="bottom-bar px-3 py-3">

                <div class="d-flex align-items-center small mb-3" style="color:#9a9da6;">
                    <i class="bi bi-person-circle fs-5 me-2"></i>
                    @User.Identity?.Name
                </div>

                <div class="d-flex gap-2">

                    <a asp-controller="Home" asp-action="Feed"
                       class="btn btn-sm flex-fill rounded-3"
                       style="background:transparent; color:#c8cad2; border:1px solid #33353c;">
                        <i class="bi bi-house me-1"></i> Site
                    </a>

                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="flex-fill">
                        <button type="submit" class="btn btn-sm w-100 rounded-3"
                                style="background:transparent; color:#c8cad2; border:1px solid #33353c;">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>

                </div>

            </div>

        </div>

       
        <div class="flex-grow-1 p-4" style="background:#f6f7fb;">

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success">@TempData["success"]</div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger">@TempData["error"]</div>
            }

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>