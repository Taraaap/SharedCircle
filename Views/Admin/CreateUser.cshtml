@model SharedCircle.ViewModels.AdminCreateUserVM

@{
    ViewData["Title"] = "Create User";
    Layout = "_AdminLayout";
}

<div class="mb-4">

    <a asp-controller="Admin"
       asp-action="Users"
       class="text-decoration-none text-muted small">

        <i class="bi bi-arrow-left me-2"></i>
        Back to Users

    </a>

</div>


<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center mb-4">

                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                         style="width:48px; height:48px; background:rgba(91,141,239,0.12);">
                        <i class="bi bi-person-plus fs-4" style="color:#5b8def;"></i>
                    </div>

                    <div>
                        <h4 class="fw-semibold mb-0" style="color:#2b2d33;">Create User</h4>
                        <p class="text-muted small mb-0">Create a new SharedCircle account</p>
                    </div>

                </div>

                <hr class="mb-4">

                <form asp-controller="Admin" asp-action="CreateUser" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert">
                    </div>

                    <div class="mb-3">

                        <label asp-for="FullName" class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:0.5px;">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-person text-muted"></i>
                            </span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0"  />
                        </div>

                        <span asp-validation-for="FullName" class="text-danger small">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Email" class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:0.5px;">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-envelope text-muted"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0"  autocomplete="email" />
                        </div>

                        <span asp-validation-for="Email" class="text-danger small">
                        </span>

                    </div>



                    <div class="mb-3">

                        <label asp-for="Password" class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:0.5px;">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input asp-for="Password" class="form-control border-start-0 ps-0"  autocomplete="new-password" />
                        </div>

                        <span asp-validation-for="Password" class="text-danger small">
                        </span>

                    </div>


                    

                    <div class="mb-3">

                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:0.5px;">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-lock-fill text-muted"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0"  autocomplete="new-password" />
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger small">
                        </span>

                    </div>



                    <div class="mb-4">

                        <label asp-for="Role" class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:0.5px;">
                            Role
                        </label>

                        <select asp-for="Role" class="form-select">

                            <option value="User">
                                User
                            </option>

                            <option value="Admin">
                                Admin
                            </option>

                        </select>

                        <span asp-validation-for="Role" class="text-danger small">
                        </span>

                      

                    </div>




                    <div class="d-flex gap-2 pt-2">

                        <a asp-controller="Admin"
                           asp-action="Users"
                           class="btn btn-outline-secondary rounded-pill px-4">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary rounded-pill px-4">

                            <i class="bi bi-person-plus me-2"></i>

                            Create User

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}