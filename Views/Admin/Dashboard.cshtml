@using SharedCircle.ViewModels
@using System.Text.Json
@model AdminDashboardVM

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}
@* ===== TOP PERFORMERS ===== *@
<div class="row g-4 mt-2">

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3" style="color:#2b2d33;">Top Liked Posts</h6>

                @if (!Model.TopLikedPosts.Any())
                {
                    <p class="text-muted small mb-0">No posts yet.</p>
                }
                @foreach (var post in Model.TopLikedPosts)
                {
                    <a asp-action="PostDetails" asp-route-id="@post.Id" class="d-flex align-items-center text-decoration-none text-dark mb-2 pb-2 border-bottom">
                        <img src="@(string.IsNullOrEmpty(post.AuthorImage) ? "/images/default-profile.png" : post.AuthorImage)"
                             width="32" height="32" class="rounded-circle me-2" style="object-fit:cover;">
                        <div class="flex-grow-1 text-truncate small">
                            <div class="text-truncate" style="max-width:180px;">@post.Caption</div>
                            <div class="text-muted" style="font-size:11px;">@post.AuthorName</div>
                        </div>
                        <span class="badge rounded-pill bg-danger-subtle text-danger">
                            <i class="bi bi-heart-fill me-1"></i>@post.LikeCount
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3" style="color:#2b2d33;">Most Active Users</h6>

                @if (!Model.TopActiveUsers.Any())
                {
                    <p class="text-muted small mb-0">No activity yet.</p>
                }
                @foreach (var user in Model.TopActiveUsers)
                {
                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@user.Id"
                       class="d-flex align-items-center text-decoration-none text-dark mb-2 pb-2 border-bottom">
                        <img src="@(string.IsNullOrEmpty(user.ProfileImage) ? "/images/default-profile.png" : user.ProfileImage)"
                             width="32" height="32" class="rounded-circle me-2" style="object-fit:cover;">
                        <div class="flex-grow-1 small">@user.FullName</div>
                        <span class="badge rounded-pill" style="background:#e8f0ff; color:#3b6fd6;">
                            @user.Count actions
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3" style="color:#2b2d33;">Most Followed</h6>

                @if (!Model.MostFollowedUsers.Any())
                {
                    <p class="text-muted small mb-0">No follows yet.</p>
                }
                @foreach (var user in Model.MostFollowedUsers)
                {
                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@user.Id"
                       class="d-flex align-items-center text-decoration-none text-dark mb-2 pb-2 border-bottom">
                        <img src="@(string.IsNullOrEmpty(user.ProfileImage) ? "/images/default-profile.png" : user.ProfileImage)"
                             width="32" height="32" class="rounded-circle me-2" style="object-fit:cover;">
                        <div class="flex-grow-1 small">@user.FullName</div>
                        <span class="badge rounded-pill" style="background:#fbe9f0; color:#c14a7d;">
                            <i class="bi bi-person-heart me-1"></i>@user.Count
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>

</div>


@* ===== RECENT SIGNUPS + ACTIVITY FEED ===== *@
<div class="row g-4 mt-2">

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0" style="color:#2b2d33;">Recent Signups</h6>
                    <a asp-action="Users" class="text-decoration-none small">View all</a>
                </div>

                @if (!Model.RecentSignups.Any())
                {
                    <p class="text-muted small mb-0">No users yet.</p>
                }
                @foreach (var user in Model.RecentSignups)
                {
                    <a asp-action="UserDetails" asp-route-id="@user.Id"
                       class="d-flex align-items-center text-decoration-none text-dark mb-2 pb-2 border-bottom">
                        <img src="@(string.IsNullOrEmpty(user.ProfileImage) ? "/images/default-profile.png" : user.ProfileImage)"
                             width="36" height="36" class="rounded-circle me-2" style="object-fit:cover;">
                        <div class="flex-grow-1 small">@user.FullName</div>
                        <span class="text-muted small">@user.JoinDate.ToString("MMM dd")</span>
                    </a>
                }

            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0" style="color:#2b2d33;">Recent Activity</h6>
                    <a asp-action="Posts" class="text-decoration-none small">View all</a>
                </div>

                @if (!Model.RecentPosts.Any())
                {
                    <p class="text-muted small mb-0">No posts yet.</p>
                }
                @foreach (var post in Model.RecentPosts)
                {
                    <a asp-action="PostDetails" asp-route-id="@post.Id"
                       class="d-flex align-items-center text-decoration-none text-dark mb-2 pb-2 border-bottom">
                        <img src="@(string.IsNullOrEmpty(post.AuthorImage) ? "/images/default-profile.png" : post.AuthorImage)"
                             width="36" height="36" class="rounded-circle me-2" style="object-fit:cover;">
                        <div class="flex-grow-1 small text-truncate" style="max-width:220px;">
                            <span class="fw-semibold">@post.AuthorName</span> — @post.Caption
                        </div>
                        <span class="text-muted small">@post.CreatedAt.ToString("MMM dd")</span>
                    </a>
                }

            </div>
        </div>
    </div>

</div>


@* ===== MONTH-OVER-MONTH + MODERATION SNAPSHOT ===== *@
<div class="row g-4 mt-2">

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">

                <h6 class="fw-semibold mb-4" style="color:#2b2d33;">Month-over-Month</h6>

                <div class="row g-3">
                    @foreach (var m in Model.MonthComparisons)
                    {
                        <div class="col-md-4">
                            <div class="p-3 rounded-3" style="background:#f6f7fb;">
                                <div class="text-muted small mb-1">@m.Metric</div>
                                <div class="fw-bold fs-4" style="color:#2b2d33;">@m.ThisMonth</div>
                                <div class="small @(m.PercentChange >= 0 ? "text-success" : "text-danger")">
                                    <i class="bi bi-arrow-@(m.PercentChange >= 0 ? "up" : "down") me-1"></i>
                                    @m.PercentChange% vs last month (@m.LastMonth)
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">

                <div class="d-flex align-items-center justify-content-center rounded-4 mx-auto mb-3"
                     style="width:52px;height:52px;background:linear-gradient(135deg,#e57373,#c94f4f);">
                    <i class="bi bi-shield-lock-fill fs-4 text-white"></i>
                </div>

                <div class="text-muted small mb-1">LOCKED ACCOUNTS</div>
                <h2 class="fw-bold mb-2" style="color:#2b2d33;">@Model.LockedUsersCount</h2>

                <a asp-action="Users" class="btn btn-sm btn-outline-danger rounded-pill mx-auto" style="width:fit-content;">
                    View Users
                </a>

            </div>
        </div>
    </div>

</div>