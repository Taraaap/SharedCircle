@model SharedCircle.ViewModels.FeedVM

@{
    ViewData["Title"] = "Feed";
}

@using Microsoft.AspNetCore.Identity
@using SharedCircle.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="row g-4">


    <!-- MAIN FEED -->
    <div class="col-lg-8">


        <!-- CREATE POST BOX -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">


            <div class="card-body">


                <div class="d-flex align-items-center gap-3">


                    <img src="@(string.IsNullOrEmpty(currentUser.ProfileImage)
                            ? "/images/default-profile.png"
                            : currentUser.ProfileImage)"
                         width="50"
                         height="50"
                         class="rounded-circle me-3"
                         style="object-fit:cover;">


                    <div class="form-control rounded-pill bg-light border-0 py-3"
                         data-bs-toggle="modal"
                         data-bs-target="#createPostModal"
                         style="cursor:pointer">


                        What's on your mind,   @currentUser?.FullName ?


                    </div>



                    <button class="btn btn-light rounded-circle"
                            data-bs-toggle="modal"
                            data-bs-target="#createPostModal">


                        <i class="bi bi-image text-success fs-5"></i>


                    </button>


                </div>


            </div>


        </div>



        <!-- CREATE POST MODAL -->


        <div class="modal fade"
             id="createPostModal">


            <div class="modal-dialog modal-dialog-centered modal-lg">


                <form asp-controller="Posts"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div class="modal-content rounded-4">


                    <div class="modal-header">

                        <h5 class="fw-bold">
                            Create Post
                        </h5>


                        <button class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                     

                    </div>



                    <div class="modal-body">


                        <div class="d-flex align-items-center mb-3">


                                <img src="@(string.IsNullOrEmpty(currentUser.ProfileImage)
                                                            ? "/images/default-profile.png"
                                                            : currentUser.ProfileImage)"
                                     width="50"
                                     height="50"
                                     class="rounded-circle me-3"
                                     style="object-fit:cover;">

                            <div>

                                <h6 class="mb-0">
                                        @currentUser?.FullName 
                                </h6>


                                <small class="text-muted">
                                    Public
                                </small>


                            </div>


                        </div>



                            <textarea asp-for="NewPost.Caption"
                                      class="form-control border-0 shadow-none"
                                      rows="5"
                                      placeholder="What's on your mind?"></textarea>



                        <img id="previewImage"
                             class="img-fluid rounded mt-3 d-none">

                    </div>




                    <div class="modal-footer justify-content-between">


                        <label for="imageUpload" class="btn btn-light">

                            <i class="bi bi-image-fill text-success me-2"></i>

                            Photo

                        </label>


                        <input asp-for="NewPost.Image"
                               type="file"
                               id="imageUpload"
                               hidden
                               accept="image/*">


                        <button type="submit"
                                class="btn btn-primary px-5">
                            Post
                        </button>


                    </div>


                </div>
                </form>

            </div>


        </div>




        <!-- POST CARD -->
        @foreach (var post in Model.Posts)
        {

            <div class="card shadow-sm border-0 rounded-4 mb-4">

                <div class="card-body">


                    <div class="d-flex align-items-center mb-3">


                        <img src="@(string.IsNullOrEmpty(post.User.ProfileImage)
                                        ? "/images/default-profile.png"
                                        : post.User.ProfileImage)"
                             width="45"
                             height="45"
                             class="rounded-circle me-3"
                             style="object-fit:cover;">


                        <div>

                            <h6 class="mb-0">
                                @post.User.FullName
                            </h6>


                            <small class="text-muted">
                                @post.CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")
                            </small>

                        </div>


                    </div>



                    <p>
                        @post.Caption
                    </p>



                    @if (post.ImageUrl != null)
                    {
                        <img src="@post.ImageUrl"
                             class="img-fluid rounded-3 w-100 mb-3">
                    }



                    <div class="d-flex border-top pt-2">

                        <button class="btn btn-light flex-fill like-btn"
                                data-post-id="@post.Id">
                           <span class="like-count">@post.LikeCount</span>
                           Like
                        </button>


                        <button class="btn btn-light flex-fill">
                            <i class="bi bi-chat"></i>
                            Comment
                        </button>


                        <button class="btn btn-light flex-fill">
                            <i class="bi bi-share"></i>
                            Share
                        </button>


                    </div>


                </div>

            </div>

        }


    </div>





    <!-- RIGHT SIDEBAR -->


    <div class="col-lg-4">


        <!-- Suggested -->


        <div class="card shadow-sm border-0 rounded-4 mb-4">


            <div class="card-header bg-white fw-bold">

                Suggested Users

            </div>



            <div class="card-body">


                <div class="d-flex align-items-center mb-3">


                    <img src="~/images/default-profile.png"
                         width="40"
                         height="40"
                         class="rounded-circle me-2">


                    Alex Johnson


                </div>



                <div class="d-flex align-items-center mb-3">


                    <img src="~/images/default-profile.png"
                         width="40"
                         height="40"
                         class="rounded-circle me-2">


                    Emma Watson


                </div>



                <div class="d-flex align-items-center">


                    <img src="~/images/default-profile.png"
                         width="40"
                         height="40"
                         class="rounded-circle me-2">


                    David Miller


                </div>


            </div>


        </div>





        <!-- Trending -->


        <div class="card shadow-sm border-0 rounded-4">


            <div class="card-header bg-white fw-bold">

                Trending

            </div>



            <div class="card-body">


                <p>#ASP.NET</p>

                <p>#CSharp</p>

                <p>#EntityFramework</p>

                <p>#WebDevelopment</p>


            </div>


        </div>


    </div>



</div>




@section Scripts {
    <script>
        const upload = document.getElementById("imageUpload");

        upload?.addEventListener("change", function () {
            if (this.files.length > 0) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    let img = document.getElementById("previewImage");
                    img.src = e.target.result;
                    img.classList.remove("d-none");
                };

                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>
}