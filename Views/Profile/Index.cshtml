@model ProfileVM
@using SharedCircle.Helpers
@using Microsoft.AspNetCore.Identity
@using SharedCircle.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container py-4">

    @* ============ PROFILE HEADER — no cover, just avatar + info ============ *@
    <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">

        <img src="@(string.IsNullOrEmpty(Model.User.ProfileImage) ? "/images/default-profile.png" : Model.User.ProfileImage)"
             width="120" height="120"
             class="rounded-circle border shadow-sm"
             style="object-fit:cover;">

        <div class="flex-grow-1">
            <h3 class="fw-bold mb-0">@Model.User.FullName</h3>
            @if (!string.IsNullOrEmpty(Model.User.Bio))
            {
                <p class="text-muted mb-0">@Model.User.Bio</p>
            }
        </div>

        <div class="d-flex gap-2">
            @if (Model.IsOwnProfile)
            {
                <form asp-action="UploadProfileImage" asp-controller="Profile" method="post" enctype="multipart/form-data">
                    <label class="btn btn-outline-secondary rounded-pill">
                        <i class="bi bi-camera me-1"></i> Change Photo
                        <input type="file" name="image" hidden accept="image/*" onchange="this.form.submit()">
                    </label>
                </form>
                <a asp-controller="Profile" asp-action="Edit" class="btn btn-primary rounded-pill">
                    <i class="bi bi-pencil-square me-1"></i> Edit Profile
                </a>
            }
            else
            {
                <button id="profileFollowBtn"
                        class="btn @(Model.IsFollowing ? "btn-outline-secondary" : "btn-primary") rounded-pill"
                        data-user-id="@Model.User.Id"
                        data-is-own-profile="@Model.IsOwnProfile.ToString().ToLower()">
                    @(Model.IsFollowing ? "Following" : "Follow")
                </button>

                <a href="/Chat/Index?userId=@Model.User.Id"
                   id="messageUserBtn"
                   data-user-id="@Model.User.Id"
                   class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-chat-dots me-1"></i> Message
                </a>
            }
        </div>

    </div>

    @* ============ STAT / INFO STRIP ============ *@
    <div class="d-flex flex-wrap gap-4 align-items-center py-3 mt-3 border-top border-bottom">

        <a href="#" id="followersBtn" data-user-id="@Model.User.Id" class="text-decoration-none text-dark">
            <span class="fw-bold" id="followersCount">@Model.FollowersCount</span>
            <span class="text-muted"> Followers</span>
        </a>

        <a href="#" id="followingBtn" data-user-id="@Model.User.Id" class="text-decoration-none text-dark">
            <span class="fw-bold" id="followingCount">@Model.FollowingCount</span>
            <span class="text-muted"> Following</span>
        </a>

        <span class="text-muted">
            <i class="bi bi-images me-1"></i>@Model.Posts.Count Posts
        </span>

        <span class="text-muted">
            <i class="bi bi-calendar-event me-1"></i>Joined @Model.User.JoinDate.ToString("MMMM yyyy")
        </span>

    </div>

    @* ============ POSTS — single column, full width ============ *@
    <div class="py-4">

        <h5 class="fw-bold mb-3">
            @(Model.IsOwnProfile ? "My Posts" : Model.User.FullName + "'s Posts")
        </h5>

        @if (!Model.Posts.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 text-muted">
                <i class="bi bi-images fs-1 mb-2"></i>
                No posts yet.
            </div>
        }

        @foreach (var post in Model.Posts)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="d-flex align-items-center">
                            <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@post.User.Id">
                                <img src="@(string.IsNullOrEmpty(post.User.ProfileImage) ? "/images/default-profile.png" : post.User.ProfileImage)"
                                     width="45" height="45"
                                     class="rounded-circle me-3"
                                     style="object-fit:cover;" />
                            </a>
                            <div>
                                <h6 class="mb-0">
                                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@post.User.Id"
                                       class="text-decoration-none text-dark fw-semibold">
                                        @post.User.FullName
                                    </a>
                                </h6>
                                <small class="text-muted">@TimeHelper.GetTimeAgo(post.CreatedAt)</small>
                            </div>
                        </div>

                        @if (post.UserId == currentUser.Id)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-circle" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Posts" asp-action="Delete" method="post">
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <button class="dropdown-item text-danger" type="submit">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>

                    <p class="mb-3">@post.Caption</p>

                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="img-fluid rounded-3 w-100 mb-3">
                    }

                    <div class="d-flex border-top pt-2">
                        <button class="btn btn-light flex-fill like-btn" data-post-id="@post.Id">
                            <i class="bi @(post.IsLiked ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                            <span class="like-count @(post.LikeCount == 0 ? "d-none" : "")">@post.LikeCount</span>
                            Likes
                        </button>

                        <button class="btn btn-light flex-fill" data-bs-toggle="modal" data-bs-target="#commentModal-@post.Id">
                            <i class="bi bi-chat"></i>
                            <span class="comment-count" id="comment-count-@post.Id" data-post-id="@post.Id">
                                @if (post.CommentCount > 0)
                                {
                                    @post.CommentCount
                                }
                            </span>
                            Comment
                        </button>

                        <button class="btn btn-light flex-fill">
                            <i class="bi bi-share"></i> Share
                        </button>
                    </div>

                </div>
            </div>

            <div class="modal fade" id="commentModal-@post.Id">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h5 class="fw-bold">Comments</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div id="comments-@post.Id">
                                @foreach (var comment in post.Comments)
                                {
                                    <div class="d-flex mb-3">
                                        <img src="@(string.IsNullOrEmpty(comment.User.ProfileImage) ? "/images/default-profile.png" : comment.User.ProfileImage)"
                                             width="40" height="40"
                                             class="rounded-circle me-2"
                                             style="object-fit:cover;">
                                        <div class="bg-light rounded-3 px-3 py-2 flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong>
                                                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@comment.User.Id"
                                                       class="text-decoration-none text-dark">
                                                        @comment.User.FullName
                                                    </a>
                                                </strong>
                                                @if (comment.UserId == currentUser.Id)
                                                {
                                                    <form asp-controller="Comments" asp-action="Delete" method="post">
                                                        <input type="hidden" name="id" value="@comment.Id" />
                                                        <button class="btn btn-sm text-danger">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <div>@comment.Text</div>
                                            <small class="text-muted">@TimeHelper.GetTimeAgo(comment.CreatedAt)</small>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="input-group mt-3">
                                <input type="text" class="form-control comment-text" data-post-id="@post.Id" placeholder="Write a comment...">
                                <button class="btn btn-primary comment-btn" data-post-id="@post.Id">Send</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

</div>

<div class="modal fade" id="followModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="followModalTitle">Followers</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="followList">
                    <div class="text-center p-4">No one to show.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const upload = document.getElementById("imageUpload");
        upload?.addEventListener("change", function () {
            if (this.files.length > 0) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    let img = document.getElementById("previewImage");
                    img.src = e.target.result;
                    img.classList.remove("d-none");
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    </script>
}