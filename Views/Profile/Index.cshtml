@model ProfileVM
@using SharedCircle.Helpers

@using Microsoft.AspNetCore.Identity
@using SharedCircle.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}



<div class="row g-4 mt-2">


    @* Profile section *@
    <div class="col-lg-6">

        <div class="card rounded-4 shadow-sm" >
            <div class="card-body text-center">
                <img src="@(string.IsNullOrEmpty(Model.User.ProfileImage)? "/images/default-profile.png" : Model.User.ProfileImage  )"
                     width="120"height="120"class="rounded-circle mb-3"style="object-fit:cover;">


                @* Profile picture change *@
                @if (Model.IsOwnProfile)
{
                <form asp-action="UploadProfileImage" asp-controller="Profile" method="post"enctype="multipart/form-data">


                    <label class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-camera me-1"></i> Change Photo
                        <input type="file" name="image" hidden accept="image/*" onchange="this.form.submit()">
                    </label>
                </form>
                }
               
               

                @* edit *@
                <h3 class="fw-bold mt-3"> @Model.User.FullName
                </h3>

                <p class="text-muted"> @Model.User.Bio </p>

                <hr>

                <div class="text-start">


                    <p>

                        <i class="bi bi-envelope me-2"></i>

                        @Model.User.Email

                    </p>



                    <p>

                        <i class="bi bi-calendar me-2"></i>

                        Joined @Model.User.JoinDate.ToString("MMMM yyyy")

                    </p>

                </div>


                @if (Model.IsOwnProfile)
                {
                    <a asp-controller="Profile"  asp-action="Edit" class="btn btn-primary w-100 mt-2">
                        Edit Profile
                    </a>
                }
                else
                {
                    <button id="profileFollowBtn"
                            class="btn @(Model.IsFollowing ? "btn-outline-secondary" : "btn-primary") w-100 mt-2"
                            data-user-id="@Model.User.Id"
                            data-is-own-profile="@Model.IsOwnProfile.ToString().ToLower()">

                        @(Model.IsFollowing ? "Following" : "Follow")
                    </button>
                }

                @* Followers and Following *@
                <div class="d-flex justify-content-center gap-5 mt-3">

                    <div class="text-center">
                        <a href="#"id="followersBtn" data-user-id="@Model.User.Id" class="text-decoration-none text-dark">

                            <h5 id="followersCount">@Model.FollowersCount</h5>

                            <small>Followers</small>

                        </a>
                    </div>

                    <div class="text-center">
                        <a href="#"  id="followingBtn" data-user-id="@Model.User.Id" class="text-decoration-none text-dark">

                            <h5 id="followingCount">@Model.FollowingCount</h5>
                            <small>Following</small>

                        </a>
                    </div>

                </div>


            </div>


        </div>


    </div>




    @* user post section *@
<div class="col-lg-6">

        @if (Model.IsOwnProfile)
        {
            <h4 class="mb-3">My Posts</h4>
        }
        else
        {
            <h4 class="mb-3">@Model.User.FullName's Posts</h4>
        }

        @foreach (var post in Model.Posts)
        {

            <div class="card shadow-sm border-0 rounded-4 mb-4">

                <div class="card-body">

                    @* post header *@
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="d-flex align-items-center">

                            <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@post.User.Id">

                                <img src="@(string.IsNullOrEmpty(post.User.ProfileImage)
                                        ? "/images/default-profile.png"
                                        : post.User.ProfileImage)"
                                     width="45"
                                     height="45"
                                     class="rounded-circle me-3"
                                     style="object-fit:cover;" />

                            </a>
                            <div>

                                <h6 class="mb-0">
                                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@post.User.Id"
                                       class="text-decoration-none text-dark">
                                        @post.User.FullName
                                    </a>
                                </h6>

                                <small class="text-muted">
                                    @TimeHelper.GetTimeAgo(post.CreatedAt)
                                </small>

                            </div>

                        </div>


                        @* three dots *@
                        @if (post.UserId == currentUser.Id)
                        {
                            <div class="dropdown">

                                <button class="btn btn-light btn-sm rounded-circle"
                                        data-bs-toggle="dropdown">

                                    <i class="bi bi-three-dots"></i>

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>

                                        <form asp-controller="Posts" asp-action="Delete" method="post">

                                            <input type="hidden"  name="id" value="@post.Id" />

                                            <button class="dropdown-item text-danger" type="submit">
                                                <i class="bi bi-trash me-2"></i>
                                                Delete
                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>
                        }

                    </div>
                </div>

             
               
                <hr />


                <p class="mt-3">   @post.Caption  </p>


                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="img-fluid rounded-3 w-100 mb-3">
                    }



                    @*  ACTION BUTTONS  *@

                    <div class="d-flex border-top pt-2">

                        <button class="btn btn-light flex-fill like-btn" data-post-id="@post.Id">
                        <i class="bi @(post.IsLiked ? "bi-heart-fill text-danger" : "bi-heart")"></i>

                            <span class="like-count @(post.LikeCount == 0 ? "d-none" : "")">
                                @post.LikeCount
                            </span>

                            Likes
                        </button>


                        @*  COMMENT BUTTON  *@

                        <button class="btn btn-light flex-fill" data-bs-toggle="modal" data-bs-target="#commentModal-@post.Id">


                            <i class="bi bi-chat"></i>


                            <span class="comment-count" id="comment-count-@post.Id" data-post-id="@post.Id">

                                @if (post.CommentCount > 0)
                                {
                                    @post.CommentCount
                                }

                            </span>
                            Comment
                        </button>



                        <button class="btn btn-light flex-fill">
                            <i class="bi bi-share"></i> Share
                        </button>


                    </div>


                </div>


          




            @*  COMMENT MODAL  *@

            <div class="modal fade"
                 id="commentModal-@post.Id">


                <div class="modal-dialog modal-dialog-centered">


                    <div class="modal-content rounded-4">


                        <div class="modal-header">


                            <h5 class="fw-bold">
                                Comments
                            </h5>


                            <button class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>


                        </div>




                        <div class="modal-body">



                            @*  ALL COMMENTS  *@

                            <div id="comments-@post.Id">


                                @foreach (var comment in post.Comments)
                                {

                                    <div class="d-flex mb-3">


                                        <img src="@(string.IsNullOrEmpty(comment.User.ProfileImage) ? "/images/default-profile.png" : comment.User.ProfileImage)"
                                             width="40"
                                             height="40"
                                             class="rounded-circle me-2"
                                             style="object-fit:cover;">



                                        <div class="bg-light rounded-3 px-3 py-2 flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong>
                                                    <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@comment.User.Id"
                                                       class="text-decoration-none text-dark">
                                                        @comment.User.FullName
                                                    </a>
                                                </strong>



                                                @* Delete Comment *@
                                                @if (comment.UserId == currentUser.Id)
                                                {

                                                    <form asp-controller="Comments"   asp-action="Delete"   method="post">

                                                        <input type="hidden" name="id" value="@comment.Id" />
                                                        <button class="btn btn-sm text-danger">
                                                            <i class="bi bi-trash"></i>
                                                        </button>

                                                    </form>
                                                }
                                            </div>

                                            <div>
                                                @comment.Text
                                            </div>
                                            <small class="text-muted">

                                                @TimeHelper.GetTimeAgo(comment.CreatedAt)

                                            </small>


                                        </div>


                                    </div>

                                }


                            </div>




                           @* add comment *@


                            <div class="input-group mt-3">

                                <input type="text"   class="form-control comment-text"   data-post-id="@post.Id"placeholder="Write a comment...">
                               <button class="btn btn-primary comment-btn" data-post-id="@post.Id">
                                    Send
                               </button>


                            </div>



                        </div>


                    </div>


                </div>


            </div>


        }

        @section Scripts {
            <script>
                        const upload = document.getElementById("imageUpload");

                        upload?.addEventListener("change", function() {
                            if (this.files.length > 0) {
                                const reader = new FileReader();

                                reader.onload = function(e) {
                                    let img = document.getElementById("previewImage");
                                    img.src = e.target.result;
                                    img.classList.remove("d-none");
                                };

                                reader.readAsDataURL(this.files[0]);
                            }
                        });
            </script>
        }
</div>


@* model *@
    <div class="modal fade" id="followModal" tabindex="-1">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="followModalTitle">
                        Followers
                    </h5>

                    <button class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body p-0">

                    <div id="followList">

                        <div class="text-center p-4">

                            No one to show.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>