@using Microsoft.AspNetCore.Identity
@using SharedCircle.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container-fluid">

    <nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm px-4 py-2">

        
        <a class="navbar-brand d-flex align-items-center me-4"
           asp-controller="Home"
           asp-action="Feed">

            <img src="~/images/logo.png"
                 width="40"
                 height="40"
                 class="rounded-circle me-2">

            <span class="fw-bold fs-4">SharedCircle</span>
        </a>

        @* search *@
        <form class="d-flex ms-2">
            <div class="position-relative">

                <input id="userSearch"
                       class="form-control"
                       placeholder="Search users..." />

                <div id="searchResult"
                     class="list-group position-absolute w-100 shadow"
                     style="z-index:1000;display:none;">
                </div>

            </div>
        </form>

        @* right *@
        <ul class="navbar-nav ms-auto align-items-center">

            @* notification *@
            <li class="nav-item dropdown me-2">

                <a class="nav-link px-2 position-relative"
                   href="#"
                   id="notificationDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">

                    <i class="bi bi-bell fs-5"></i>

                    <span id="notificationBadge"
                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                        0
                    </span>

                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-0"
                    style="width:380px;">

                    <li class="border-bottom px-3 py-2">
                        <h6 class="fw-bold mb-0">Notifications</h6>
                    </li>

                    <li id="notificationList"
                        style="max-height:400px; overflow-y:auto; list-style:none;">

                        <div class="text-center text-muted py-4">
                            No notifications
                        </div>

                    </li>

                </ul>

            </li>

           @* chat *@
            <li class="nav-item me-2">

                <a class="nav-link px-2" asp-controller="Chat" asp-action="Index">
                    <i class="bi bi-chat-dots fs-5"></i>
                </a>

            </li>

           @* profile *@
            <li class="nav-item dropdown ms-2">

                <a class="nav-link dropdown-toggle d-flex align-items-center"
                   href="#"
                   data-bs-toggle="dropdown">

                    <img src="@(string.IsNullOrEmpty(currentUser?.ProfileImage)
                                                        ? "/images/default-profile.png"
                                                        : currentUser.ProfileImage)"
                         width="38"
                         height="38"
                         class="rounded-circle me-2"
                         style="object-fit:cover;">

                    <span class="fw-semibold">@currentUser?.FullName</span>

                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                    <li>
                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="dropdown-item">

                            <i class="bi bi-person me-2"></i>
                            Profile

                        </a>
                    </li>

                </ul>

            </li>

        </ul>

    </nav>

</div>