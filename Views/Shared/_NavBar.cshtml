@using Microsoft.AspNetCore.Identity
@using SharedCircle.Models
@inject UserManager<ApplicationUser> UserManager

    @{
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container-fluid bg-white shadow-sm">


    <nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm">

        <a class="navbar-brand d-flex align-items-center" asp-controller="Home"  asp-action="Feed">
            <img src="~/images/logo.png" width="40" height="40"    class="rounded-circle me-2">
            <span class="fw-bold fs-4"> SharedCircle </span>
        </a>



        <form class="d-flex ms-5">

            <input class="form-control rounded-pill"  placeholder="Search friends">

        </form>



        <ul class="navbar-nav ms-auto align-items-center">


            <li class="nav-item">

                <a class="nav-link">

                    <i class="bi bi-bell fs-5"></i>

                </a>

            </li>



            <li class="nav-item">

                <a class="nav-link">

                    <i class="bi bi-chat-dots fs-5"></i>

                </a>

            </li>



            <li class="nav-item dropdown">


                <a class="nav-link dropdown-toggle"
                   data-bs-toggle="dropdown">


                    <img src="@(string.IsNullOrEmpty(currentUser.ProfileImage)  ? "/images/default-profile.png": currentUser.ProfileImage)"
                         width="38"
                         height="38"
                         class="rounded-circle me-2"
                         style="object-fit:cover;">


                    @(currentUser.FullName)


                </a>



                <ul class="dropdown-menu dropdown-menu-end">


                    <li>
                        <a asp-controller="Profile" asp-action="Index" class="text-decoration-none text-dark p-3">
                         <i class="bi bi-person me-3"></i>Profile
                        </a>
                    </li>
                    </li>

                </ul>
    </nav>


</div>