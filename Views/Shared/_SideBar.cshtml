@using Microsoft.AspNetCore.Identity

<div class="d-flex flex-column">

    <div class="d-flex flex-column">

          <a asp-controller="Home" asp-action="Feed" class="d-flex align-items-center text-decoration-none text-dark px-3 py-2 rounded mb-1">
        <i class="bi bi-house fs-5 me-3"></i>
        <span>Home</span>
        </a>

        <a asp-controller="Friends" asp-action="Index" class="d-flex align-items-center text-decoration-none text-dark px-3 py-2 rounded mb-1">
            <i class="bi bi-people fs-5 me-3"></i>
            <span>Friends</span>
        </a>


        <hr class="my-2">

        <a asp-controller="Settings" asp-action="Index" class="d-flex align-items-center text-decoration-none text-dark px-3 py-2 rounded mb-1">
            <i class="bi bi-gear fs-5 me-3"></i>
            <span>Settings</span>
        </a>

        <form asp-area="Identity"   asp-page="/Account/Logout"   method="post">

            <button type="submit"  class="d-flex align-items-center text-decoration-none text-dark px-3 py-2 rounded border-0 bg-transparent w-100 text-start">

                <i class="bi bi-box-arrow-right fs-5 me-3"></i>
                <span>Logout</span>

            </button>

        </form>

    </div>

</div>