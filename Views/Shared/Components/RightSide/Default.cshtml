@model List<ApplicationUser>
@using SharedCircle.Models




<div class="card shadow-sm border-0 rounded-4 mb-4">

    <div class="card-header bg-white fw-bold">
        Suggested Users
    </div>


    <div class="card-body">

        @foreach(var user in Model)
        {
            <div class="d-flex align-items-center mb-3">


                <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@user.Id">

                    <img src="@(string.IsNullOrEmpty(user.ProfileImage)? "/images/default-profile.png": user.ProfileImage)"
                         width="45"
                         height="45"
                         class="rounded-circle me-3"
                         style="object-fit:cover;" />

                </a>
                <div class="flex-grow-1">

                    <h6 class="mb-0">
                        <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@user.Id"
                           class="text-decoration-none text-dark">
                            @user.FullName
                        </a>
                    </h6>

                </div>


                <button class="btn btn-sm btn-primary follow-btn"
                        data-user-id="@user.Id">
                    Follow
                </button>


            </div>
        }


    </div>

</div>