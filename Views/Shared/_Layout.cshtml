<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"]  SharedCircle
    </title>
        <link rel="icon" type="image/png" href="~/image/logo.png" asp-append-version="true" />
   


    <link rel="icon" href="~/image/logo.png">


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <link rel="stylesheet"   href="~/css/site.css" />


</head>

<body>


    @if (!Context.Request.Path.StartsWithSegments("/Identity"))
    {

        <partial name="_Navbar" />

        <partial name="_Notification" />


        <div class="container-fluid mt-5 pt-3">

            <div class="row">


                @* left *@
                <div class="col-lg-2">

                    <div class="sticky-top" style="top:80px;">

                        <partial name="_Sidebar" />

                    </div>

                </div>



               @* feed *@
                <div class="col-lg-7">

                    @RenderBody()

                </div>



                @* rigth *@
                @if (ViewContext.RouteData.Values["Controller"]?.ToString() != "Profile")
                    {
                        <div class="col-lg-3">

                            <div class="sticky-top" style="top:80px;">

                            @* <partial name="_RightSide" /> *@
                            @await Component.InvokeAsync("RightSide")

                            </div>

                        </div>
                    }

            </div>

        </div>


    }
    else
    {

        @RenderBody()

    }



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/profile.js"></script>
    <script src="~/js/navbar.js"></script>
    <script src="~/js/chat.js"></script>



    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>