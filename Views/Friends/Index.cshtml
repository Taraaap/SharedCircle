@using SharedCircle.Models
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Friends";
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Friends
        </h2>
        <div class="text-muted">
            @Model.Count() friends
        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-people fs-1 text-muted"></i>

            <h5 class="fw-bold mt-3">
                No friends yet
            </h5>

            <p class="text-muted">
                When someone follows you back, they'll appear here.
            </p>

        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var friend in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@friend.Id">
                                    <img src="@(string.IsNullOrEmpty(friend.ProfileImage)     ? "/images/default-profile.png" : friend.ProfileImage)"
                                         width="60"
                                         height="60"
                                         class="rounded-circle"
                                         style="object-fit:cover;">
                                </a>


                                <div class="ms-3">

                                    <a asp-controller="Profile" asp-action="ViewProfile"    asp-route-id="@friend.Id"
                                       class="text-decoration-none text-dark">
                                        <div class="fw-bold">
                                            @friend.FullName
                                        </div>

                                    </a>

                                    <small class="text-muted">
                                        Friend
                                    </small>

                                </div>

                            </div>


                            <div class="d-flex mt-3">

                                <a asp-controller="Chat"  asp-action="Index"  asp-route-userId="@friend.Id"
                                   class="btn btn-primary btn-sm w-100">
                                   <i class="bi bi-chat-dots me-1"></i>
                                    Message

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>